    <preface>
      <p>
        <docNumber>2026/17.</docNumber>
        <docTitle refersTo="#resolutionTitle">
          <span class="bold">	Reorganization of the work of the Economic Commission for Africa</span>
        </docTitle>
      </p>
    </preface>
    <preamble>
      <formula name="enactingFormula" eId="formula_1">
        <p xml:space="preserve">
          <span class="italic">The Economic and Social Council</span>,</p>
      </formula>
      <container name="Noting" eId="container_2">
        <p xml:space="preserve">	<span class="italic">Noting</span> the adoption by the Conference of African Ministers of Finance, Planning and Economic Development during the fifty-eighth session of the Economic Commission for Africa, held in Tangier, Morocco, on 2 and 3 April 2026, of resolution 2026/3 on the reorganization of the work of the Economic Commission for Africa, in which it authorized the Commission to reorganize its programme of work by streamlining its divisions and sections, without altering the intergovernmental mandates or geographic coverage of the Commission,</p>
      </container>
    </preamble>
    <mainBody>
      <paragraph eId="para_3" class="SingleTxt">
        <content eId="para_3__content">
          <p xml:space="preserve">	<span class="italic">Endorses</span> resolution 2026/3 of the Conference of African Ministers of Finance, Planning and Economic Development on the reorganization of the work of the Economic Commission for Africa, annexed to the present resolution.</p>
        </content>
      </paragraph>
    </mainBody>
