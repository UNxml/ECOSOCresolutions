      <p>
        <inline name="agenda item name">Coordination, programme and other questions: long-term programme of support for Haiti</inline>
      </p>
      <p>
        <docTitle>Resolution adopted by the Economic and Social Council on 21 July 2026</docTitle>
      </p>
      <p xml:space="preserve">
        <docProponent refersTo="#plenaryMeeting">[on a proposal considered in plenary meeting (<inline name="originating document">E/2026/L.13</inline>)]</docProponent>
