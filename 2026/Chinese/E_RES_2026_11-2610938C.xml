      <p>
        <inline name="agenda item name">协调、方案和其他问题：非传染性疾病预防和控制</inline>
      </p>
      <p>
        <docTitle>2026年7月21日经济及社会理事会决议</docTitle>
      </p>
      <p xml:space="preserve">
        <docProponent refersTo="#plenaryMeeting">[根据全体会议审议的一项提案 (<inline name="originating document">E/2026/L.18</inline>)]</docProponent>
      </p>
