      <p>
        <inline name="agenda item name">社会与人权问题：麻醉药品</inline>
      </p>
      <p>
        <docTitle>2026年6月10日经济及社会理事会决议</docTitle>
      </p>
      <p xml:space="preserve">
        <docProponent>[根据麻醉药品委员会的建议 (<inline name="originating document">E/2026/28</inline>)]</docProponent>
      </p>
