      <p>
        <inline name="agenda item name">إقرار جدول الأعمال ومسائل تنظيمية أخرى</inline>
      </p>
      <p>
        <docTitle>قرار اتخذه المجلس الاقتصادي والاجتماعي في 31 تموز/يوليه 2025</docTitle>
      </p>
      <p xml:space="preserve">
        <docProponent refersTo="#plenaryMeeting">[بناء على مقترح نظر فيه في جلسة عامة (<inline name="originating document">E/2026/L.1</inline>)]</docProponent>
      </p>
    </coverPage>
    <preface>
      <p>
        <docNumber>2026/1</docNumber>
        <docTitle refersTo="#resolutionTitle">
          <span class="bold">	ترتيبات العمل لدورة المجلس الاقتصادي والاجتماعي لعام 2026</span>
        </docTitle>
      </p>
    </preface>
    <preamble>
      <formula name="enactingFormula" eId="formula_1">
        <p xml:space="preserve">
          <span class="bold italic">إن المجلس الاقتصادي والاجتماعي</span>،</p>
      </formula>
      <container name="إذ يشير" eId="container_2">
        <p xml:space="preserve">	<span class="bold italic">إذ يشير</span> إلى قرارات الجمعية العامة <a href="https://docs.un.org/ar/A/RES/61/16">61/16</a> المؤرخ 20 تشرين الثاني/نوفمبر 2006 و <a href="https://docs.un.org/ar/A/RES/68/1">68/1</a> المؤرخ 20 أيلول/سبتمبر 2013 و <a href="https://docs.un.org/ar/A/RES/72/305">72/305</a> المؤرخ 23 تموز/يوليه 2018 و <a href="https://undocs.org/ar/E/RES/75/290">75/290</a> ألف المؤرخ 25 حزيران/يونيه 2021 و <a href="https://documents.un.org/doc/undoc/gen/n24/175/53/pdf/n2417553.pdf?token=CBF0V4N5THbm87DSSf&amp;fe=true">78/285</a> المؤرخ 7 حزيران/يونيه 2024 بشأن تعزيز المجلس الاقتصادي والاجتماعي،</p>
      </container>
      <container name="وإذ يعيد تأكيد" eId="container_3">
        <p xml:space="preserve">	<span class="bold italic">وإذ يعيد تأكيد</span> أنه يحق للمجلس، باعتباره من أجهزة الأمم المتحدة الرئيسية، أن يعقد اجتماعاتٍ مخصصة حسب الاقتضاء لتناول المستجدات العاجلة في الميادين الاقتصادية والاجتماعية والبيئية وما يتصل بها من ميادين، مع تلقي كل الدعم الفني وخدمات المؤتمرات،</p>
      </container>
      <container name="وإذ يقر" eId="container_4">
        <p xml:space="preserve">	<span class="bold italic">وإذ يقر</span> بأن المجلس، عند تحديد مواعيد دوراته واجتماعاته ومشاوراته، سيأخذ في الحسبان اجتماعات الهيئات الأخرى التي تتعامل مع القضايا الاقتصادية والاجتماعية والبيئية لتفادي أي تداخل لا داعي له بين جداول أعمالها وحشوها ببنود لا لزوم لها،</p>
      </container>
      <container name="وإذ يشير" eId="container_5">
        <p xml:space="preserve">	<span class="bold italic">وإذ يشير</span> إلى اعتماد خطةِ عمل أديس أبابا الصادرة عن المؤتمر الدولي الثالث لتمويل التنمية<sup>(</sup><authorialNote marker="1" placement="bottom" eId="authorialNote_1"><p xml:space="preserve">	()	قرار الجمعية العامة <a href="https://docs.un.org/ar/A/RES/69/313">69/313</a>، المرفق.</p></authorialNote><sup>)</sup> وخطةِ التنمية المستدامة لعام 2030<sup>(</sup><authorialNote marker="2" placement="bottom" eId="authorialNote_2"><p xml:space="preserve">	()	قرار الجمعية العامة <a href="https://docs.un.org/ar/A/RES/70/1">70/1</a>.</p></authorialNote><sup>)</sup>،</p>
      </container>
      <container name="وإذ يشير أيضا" eId="container_6">
        <p xml:space="preserve">	<span class="bold italic">وإذ يشير أيضا</span> إلى مقرره 2025/330 المؤرخ 29 تموز/يوليه 2025 بشأن المواعيد المقترحة لاجتماعات وأجزاء المجلس في عام 2026،</p>
      </container>
    </preamble>
    <mainBody>
      <paragraph eId="para_7" class="MercuryDocument">
        <num>1 -</num>
        <list eId="para_7_list">
          <intro eId="para_7_list_intro">
            <p xml:space="preserve">	<span class="bold italic">يقرر</span>، آخذاً في اعتباره أنه قد يحتاج إلى عقد اجتماعات إضافية حسب الاقتضاء، ترتيبات العمل التالية لدورة المجلس الاقتصادي والاجتماعي لعام 2026:</p>
          </intro>
          <point eId="para_7_list_point_أ">
            <num>(أ)</num>
            <content eId="para_7_list_point_أ_content">
              <p xml:space="preserve">	يُعقد منتدى الشراكات في 27 كانون الثاني/يناير 2026؛</p>
            </content>
          </point>
          <point eId="para_7_list_point_ب">
            <num>(ب)</num>
            <content eId="para_7_list_point_ب_content">
              <p xml:space="preserve">	يُعقد الجزء المتعلق بالتنسيق في 28 و 29  كانون الثاني/يناير 2026؛</p>
            </content>
          </point>
          <point eId="para_7_list_point_ج">
            <num>(ج)</num>
            <content eId="para_7_list_point_ج_content">
              <p xml:space="preserve">	يُعقد الاجتماع الخاص الذي ينظمه المجلس لمدة يوم واحد بشأن التعاون الدولي في المسائل الضريبية في 27 آذار/مارس 2026؛</p>
            </content>
          </point>
          <point eId="para_7_list_point_د">
            <num>(د)</num>
            <content eId="para_7_list_point_د_content">
              <p xml:space="preserve">	تُعقد في 8 نيسان/أبريل 2026 اجتماعات الإدارة المكرسة لإجراء انتخابات لملء الشواغر في الهيئات الفرعية للمجلس والهيئات ذات الصلة؛</p>
            </content>
          </point>
          <point eId="para_7_list_point_ه">
            <num>(ه)</num>
            <content eId="para_7_list_point_ه_content">
              <p xml:space="preserve">	يُعقد منتدى الشباب في الفترة من 14 إلى 16 نيسان/أبريل 2026؛</p>
            </content>
          </point>
          <point eId="para_7_list_point_و">
            <num>(و)</num>
            <content eId="para_7_list_point_و_content">
              <p xml:space="preserve">	يُعقد المنتدى المعني بمتابعة تمويل التنمية في الفترة من 20 إلى 24 نيسان/ أبريل 2026؛</p>
            </content>
          </point>
          <point eId="para_7_list_point_ز">
            <num>(ز)</num>
            <content eId="para_7_list_point_ز_content">
              <p xml:space="preserve">	يُعقد المنتدى المتعدد أصحاب المصلحة المعني بتسخير العلم والتكنولوجيا والابتكار لأغراض أهداف التنمية المستدامة في 6 و 7 أيار/مايو 2026؛</p>
            </content>
          </point>
          <point eId="para_7_list_point_ح">
            <num>(ح)</num>
            <content eId="para_7_list_point_ح_content">
              <p xml:space="preserve">	يُعقد الجزء المتعلق بالأنشطة التنفيذية من أجل التنمية في الفترة من 27 إلى 29 أيار/ مايو 2026؛</p>
            </content>
          </point>
          <point eId="para_7_list_point_ط">
            <num>(ط)</num>
            <content eId="para_7_list_point_ط_content">
              <p xml:space="preserve">	تُعقد اجتماعات الجزء المتعلق بالإدارة في 10 و 11 حزيران/يونيه 2026 وفي 21 و 22 تموز/يوليه 2026؛</p>
            </content>
          </point>
          <point eId="para_7_list_point_ي">
            <num>(ي)</num>
            <content eId="para_7_list_point_ي_content">
              <p xml:space="preserve">	يُعقد الاجتماع المتعلق بالانتقال من الإغاثة إلى التنمية في 16 حزيران/يونيه 2026؛</p>
            </content>
          </point>
          <point eId="para_7_list_point_ك">
            <num>(ك)</num>
            <content eId="para_7_list_point_ك_content">
              <p xml:space="preserve">	يُعقد الجزء المتعلق بالشؤون الإنسانية في الفترة من 17 إلى 19 حزيران/يونيه 2026؛</p>
            </content>
          </point>
          <point eId="para_7_list_point_ل">
            <num>(ل)</num>
            <content eId="para_7_list_point_ل_content">
              <p xml:space="preserve">	يُعقد المنتدى السياسي الرفيع المستوى المعني بالتنمية المستدامة، الذي يُنظَّم تحت رعاية المجلس، في الفترة من 6 إلى 10 تموز/يوليه 2026؛</p>
            </content>
          </point>
          <point eId="para_7_list_point_م">
            <num>(م)</num>
            <content eId="para_7_list_point_م_content">
              <p xml:space="preserve">	يُعقد الجزء الرفيع المستوى للمجلس، بما في ذلك الجزء الوزاري الذي يستغرق ثلاثة أيام المنبثق عن المنتدى السياسي الرفيع المستوى المعني بالتنمية المستدامة الذي يُنظّم تحت رعاية المجلس، في الفترة من 13 إلى 16 تموز/يوليه 2026؛</p>
            </content>
          </point>
        </list>
      </paragraph>
      <paragraph eId="para_8" class="MercuryDocument">
        <num>2 -</num>
        <content eId="para_8__content">
          <p xml:space="preserve">	<span class="bold italic">يقرر أيضا </span>أن تُعقد الجلسة التنظيمية المتعلقة ببرنامج عمل المجلس للفترة من تموز/ يوليه 2026 إلى تموز/يوليه 2027 في 23 تموز/يوليه 2026.</p>
        </content>
      </paragraph>
    </mainBody>
