    <preface>
      <p>
        <docNumber>2026/11</docNumber>
        <docTitle refersTo="#resolutionTitle">
          <span class="bold">	فرقة عمل الأمم المتحدة المشتركة بين الوكالات المعنية بالوقاية من الأمراض غير السارية ومكافحتها</span>
        </docTitle>
      </p>
    </preface>
    <preamble>
      <formula name="enactingFormula" eId="formula_1">
        <p xml:space="preserve">
          <span class="bold italic">إن المجلس الاقتصادي والاجتماعي</span>،</p>
      </formula>
      <container name="إذ يشير" eId="container_2">
        <p xml:space="preserve">	<span class="bold italic">إذ يشير</span> إلى قراراته <a href="https://docs.un.org/ar/E/RES/2013/12">2013/12</a> المؤرخ 22 تموز/يوليه 2013 و <a href="https://docs.un.org/ar/E/RES/2014/10">2014/10</a> المؤرخ 13 حزيران/ يونيه 2014 و <a href="https://docs.un.org/ar/E/RES/2015/8">2015/8</a> المؤرخ 9 حزيران/يونيه 2015 و <a href="https://docs.un.org/ar/E/RES/2016/5">2016/5</a> المؤرخ 2 حزيران/يونيه 2016 و <a href="https://docs.un.org/ar/E/RES/2017/8">2017/8</a> المؤرخ 7 حزيران/يونيه 2017 و <a href="https://docs.un.org/ar/E/RES/2018/13">2018/13</a> المؤرخ 2 تموز/يوليه 2018 و <a href="https://docs.un.org/ar/E/RES/2019/9">2019/9</a> المؤرخ 7 حزيران/يونيه 2019 و <a href="https://docs.un.org/ar/E/RES/2020/22">2020/22</a> المؤرخ 22 تموز/يوليه 2020 و <a href="https://docs.un.org/ar/E/RES/2021/27">2021/27</a> المؤرخ 22 تموز/يوليه 2021 و <a href="https://docs.un.org/ar/E/RES/2024/17">2024/17</a> المؤرخ 23 تموز/يوليه 2024 و <a href="https://docs.un.org/ar/E/RES/2025/30">2025/30</a> المؤرخ 29 تموز/يوليه 2025، وإلى مقرريه 2022/355 المؤرخ 22 تموز/يوليه 2022 و 2023/349 المؤرخ 25 تموز/يوليه 2023 بشأن فرقة عمل الأمم المتحدة المشتركة بين الوكالات المعنية بالوقاية من الأمراض غير السارية ومكافحتها،</p>
      </container>
      <container name="وإذ يرحب" eId="container_3">
        <p xml:space="preserve">	<span class="bold italic">وإذ يرحب</span> بالتقدم الذي لا تزال تحرزه فرقة العمل من خلال الجهود المشتركة بين الوكالات لتعزيز الصحة العامة والتشجيع على إنجاز الغايات المرتبطة بالأمراض غير السارية ضمن أهداف التنمية المستدامة<sup>(</sup><authorialNote marker="1" placement="bottom" eId="authorialNote_1"><p xml:space="preserve">	()	انظر قرار الجمعية العامة <a href="https://docs.un.org/ar/A/RES/70/1">70/1</a>.</p></authorialNote><sup>)</sup>، وكذلك من خلال الشراكات والتحالفات، عند الاقتضاء، للوقاية من الأمراض غير السارية وعلاجها،</p>
      </container>
      <container name="وإذ يرحب أيضا" eId="container_4">
        <p xml:space="preserve">	<span class="bold italic">وإذ يرحب أيضا</span> بالإعلان السياسي الصادر عن اجتماع الجمعية العامة الرفيع المستوى الرابع المعني بالوقاية من الأمراض غير السارية ومكافحتها وتعزيز الصحة والسلامة النفسيتين، الذي اعتُمد في 15 كانون الأول/ديسمبر 2025<sup>(</sup><authorialNote marker="2" placement="bottom" eId="authorialNote_2"><p xml:space="preserve">	()	قرار الجمعية العامة <a href="https://docs.un.org/ar/A/RES/80/117">80/117</a>، المرفق.</p></authorialNote><sup>)</sup>، والالتزامات الواردة فيه، التي تدعو، في جملة أمور أخرى، وكالات الأمم المتحدة، كل في إطار ولايته، إلى توسيع نطاق الدعم وحشده في إطار نهج منسق تتبعه الدول الأعضاء من خلال المساعدة الإنمائية التحفيزية، بما في ذلك من خلال فرقة عمل الأمم المتحدة المشتركة بين الوكالات والمعنية بالوقاية من الأمراض غير السارية ومكافحتها وصندوق الأمم المتحدة الاستئماني المتعدد الشركاء لحفز الإجراءات القُطرية المتعلقة بالأمراض غير السارية والصحة النفسية،</p>
      </container>
      <container name="وإذ يسلّم" eId="container_5">
        <p xml:space="preserve">	<span class="bold italic">وإذ يسلّم</span> بأهمية القيادة والالتزام السياسي والعمل والتعاون والتنسيق خارج القطاع الصحي لتعزيز وتسريع التدخلات الفعالة من حيث التكلفة والمتاحة والميسورة على مستوى السكان من أجل تعزيز أنماط الحياة الصحية والوقاية من الأمراض غير السارية واضطرابات الصحة النفسية،</p>
      </container>
      <container name="وإذ يحيط علما" eId="container_6">
        <p xml:space="preserve">	<span class="bold italic">وإذ يحيط علما</span> برد إدارة منظمة الصحة العالمية على التقييم المستقل الذي أجرته فرقة العمل، والذي يقر بأهمية اتخاذ إجراءات متعددة القطاعات بشأن الأمراض غير السارية، والجهود الجارية الرامية إلى زيادة تعزيز فعالية فرقة العمل وقدرتها على الاستجابة في إطار دعم الدول الأعضاء، عملاً بالإعلان السياسي الصادر عن الاجتماع الرفيع المستوى الرابع المعني بالوقاية من الأمراض غير السارية ومكافحتها وتعزيز الصحة النفسية، ومبادرة الأمم المتحدة 80 التي أطلقها الأمين العام، والتحديات المالية الراهنة التي يواجهها النظام الإنمائي المتعدد الأطراف والأوسع نطاقاً،</p>
      </container>
    </preamble>
    <mainBody>
      <paragraph eId="para_7" class="SingleTxt">
        <num>1 -</num>
        <content eId="para_7__content">
          <p xml:space="preserve">	<span class="bold italic">يحيط علما</span> بتقرير المدير العام لمنظمة الصحة العالمية عن فرقة عمل الأمم المتحدة المشتركة بين الوكالات المعنية بالوقاية من الأمراض غير السارية ومكافحتها<sup>(</sup><authorialNote marker="3" placement="bottom" eId="authorialNote_3"><p xml:space="preserve">	()	<a href="https://docs.un.org/ar/E/2026/66">E/2026/66</a>.</p></authorialNote><sup>)</sup>، والأثر المستمر لعمل فرقة العمل في دعم الدول الأعضاء للحد من عبء الأمراض غير السارية وتحسين الصحة النفسية وتحقيق أهداف التنمية المستدامة الأوسع نطاقا المتعلقة بالصحة؛</p>
        </content>
      </paragraph>
      <paragraph eId="para_8" class="MercuryDocument">
        <num>2 -</num>
        <content eId="para_8__content">
          <p xml:space="preserve">	<span class="bold italic">يدعو</span> فرقة العمل إلى مواصلة دعم الدول الأعضاء، بناءً على طلبها، في ترجمة الالتزامات العالمية إلى خطط عمل وطنية متعددة القطاعات ومحددة التكاليف، ودراسات جدوى بشأن الوقاية من الأمراض غير السارية ومكافحتها بشكل فعال، وتعزيز الصحة النفسية، مع مراعاة السياقات والأولويات الوطنية، وبما يتماشى مع الجهود الرامية إلى تعزيز التغطية الصحية الشاملة والرعاية الصحية الأولية؛</p>
        </content>
      </paragraph>
      <paragraph eId="para_10" class="MercuryDocument">
        <num>3 -</num>
        <content eId="para_10__content">
          <p xml:space="preserve">	<span class="bold italic">يهيب</span> بفرقة العمل وأعضائها إلى القيام، في نطاق ولايتها، بدعم قدرة الدول الأعضاء، بناء على طلبها، على تحسين الأطر التنظيمية والمالية والقانونية التي تعزز النتائج الصحية المواتية فيما يتعلق بالأمراض غير السارية والصحة النفسية؛</p>
        </content>
      </paragraph>
      <paragraph eId="para_13" class="MercuryDocument">
        <num>4 -</num>
        <content eId="para_13__content">
          <p xml:space="preserve">	<span class="bold italic">يهيب</span> بالجهات المانحة الثنائية والمتعددة الأطراف، وكذلك الجهات الأخرى صاحبة المصلحة، بما في ذلك المؤسسات الخيرية والمجتمع المدني والقطاع الخاص، حسب الاقتضاء، إلى تعبئة الموارد البشرية والمالية اللازمة للعمل البرنامجي لفرقة العمل، بما في ذلك عن طريق صندوق الأمم المتحدة الاستئماني المتعدد الشركاء لحفز الإجراءات القُطرية المتعلقة بالأمراض غير السارية والصحة النفسية؛</p>
        </content>
      </paragraph>
      <paragraph eId="para_17" class="MercuryDocument">
        <num>5 -</num>
        <content eId="para_17__content">
          <p xml:space="preserve">	<span class="bold italic">يدعو</span> فرقة العمل إلى تعزيز أثرها على الصعيد القطري من خلال توطيد التواصل مع المنسقين المقيمين للأمم المتحدة وأفرقة الأمم المتحدة القطرية، ودعم إدماج الأمراض غير السارية والصحة النفسية في أطر الأمم المتحدة للتعاون من أجل التنمية المستدامة، ومواصلة تطبيق نهج الدورة البرنامجية لتحسين الرصد والمساءلة والنتائج القابلة للقياس؛</p>
        </content>
      </paragraph>
      <paragraph eId="para_22" class="SingleTxt">
        <num>6 -</num>
        <content eId="para_22__content">
          <p xml:space="preserve">	<span class="bold italic">يطلب</span> إلى الأمين العام أن يقدِّم إلى المجلس في دورته لعام 2027 تقريراً عن التقدم المحرز في تنفيذ القرار <a href="https://docs.un.org/ar/E/RES/2013/12">2013/12</a> والقرارات اللاحقة، في إطار البند الفرعي المعنون ”الوقاية من الأمراض غير السارية ومكافحتها“ من البند المعنون ”مسائل التنسيق والبرنامج ومسائل أخرى“.</p>
        </content>
      </paragraph>
