    <preface>
      <p>
        <docNumber>2026/17.</docNumber>
        <docTitle refersTo="#resolutionTitle">
          <span class="bold">	Reorganización de la labor de la Comisión Económica para África</span>
        </docTitle>
      </p>
    </preface>
    <preamble>
      <formula name="enactingFormula" eId="formula_1">
        <p xml:space="preserve">
          <span class="italic">El Consejo Económico y Social</span>,</p>
      </formula>
      <container name="Observando" eId="container_2">
        <p xml:space="preserve">	<span class="italic">Observando</span> la aprobación por parte de la Conferencia de Ministros Africanos de Finanzas, Planificación y Desarrollo Económico, durante el 58º período de sesiones de la Comisión Económica para África, celebrada en Tánger (Marruecos) los días 2 y 3 de abril de 2026, de la resolución 2026/3 sobre la reorganización de la labor de la Comisión Económica para África, en la que autorizó a la Comisión a reorganizar su programa de trabajo racionalizando sus divisiones y secciones, sin alterar los mandatos intergubernamentales ni la cobertura geográfica de la Comisión,</p>
      </container>
    </preamble>
    <mainBody>
      <paragraph eId="para_3" class="SingleTxt">
        <content eId="para_3__content">
          <p xml:space="preserve">	<span class="italic">Hace suya</span> la resolución 2026/3 de la Conferencia de Ministros Africanos de Finanzas, Planificación y Desarrollo Económico sobre la reorganización de la labor de la Comisión Económica para África, que figura en el anexo de la presente resolución.</p>
        </content>
      </paragraph>
    </mainBody>
