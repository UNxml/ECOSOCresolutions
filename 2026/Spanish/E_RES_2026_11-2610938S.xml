      <p>
        <inline name="agenda item name">Cuestiones de coordinación y de programas y otras cuestiones: prevención y control de las enfermedades no transmisibles</inline>
      </p>
      <p>
        <docTitle>Resolución aprobada por el Consejo Económico y Social el 21 de julio de 2026</docTitle>
      </p>
      <p xml:space="preserve">
        <docProponent refersTo="#plenaryMeeting">[sobre la base de una propuesta examinada en sesión plenaria (<inline name="originating document">E/2026/L.18</inline>)]</docProponent>
      </p>
