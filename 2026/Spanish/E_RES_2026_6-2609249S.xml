      <p>
        <docTitle>Resolución aprobada por el Consejo Económico y Social el 10 de junio de 2026</docTitle>
      </p>
      <p xml:space="preserve">
        <docProponent refersTo="#plenaryMeeting">[sobre la base de una propuesta examinada en sesión plenaria (<inline name="originating document">E/2026/L.8</inline>)]</docProponent>
