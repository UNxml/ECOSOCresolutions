      <p>
        <docTitle>Résolution adoptée par le Conseil économique et social le 10 juin 2026</docTitle>
      </p>
      <p xml:space="preserve">
        <docProponent refersTo="#plenaryMeeting">[sur la base d’une proposition examinée en séance plénière (<inline name="originating document">E/2026/L.8</inline>)]</docProponent>
